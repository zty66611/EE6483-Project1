{
  "random_seed": 42,
  "validation_size": 0.2,
  "features": "word+char",
  "vectorizer": {
    "ngram_range": [
      1,
      2
    ],
    "min_df": 1,
    "max_features": 30000,
    "sublinear_tf": true
  },
  "char_vectorizer": {
    "analyzer": "char_wb",
    "ngram_range": [
      3,
      5
    ],
    "min_df": 2,
    "max_features": 50000,
    "sublinear_tf": true
  },
  "classifier": {
    "type": "logistic_regression",
    "C": 3,
    "max_iter": 1000,
    "class_weight": "balanced"
  }
}